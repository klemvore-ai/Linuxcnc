[Unit]
Description=CNCFusion HAL helper
After=network.target

[Service]
Type=simple
User=darrell
Group=cncfusion
WorkingDirectory=/opt/CNCFusion
RuntimeDirectory=cncfusion
ExecStart=/opt/CNCFusion/.venv/bin/python -m agent.hal_helper
Restart=on-failure
RestartSec=2
ProtectSystem=full
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
