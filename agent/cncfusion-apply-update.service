[Unit]
Description=Apply a staged CNCFusion application update
After=network.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/CNCFusion
ExecStart=/opt/CNCFusion/.venv/bin/python -m agent.apply_update
ExecStartPost=/bin/systemctl restart cncfusion-hal-helper.service cncfusion-agent.service
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt /var/lib/cncfusion/updates