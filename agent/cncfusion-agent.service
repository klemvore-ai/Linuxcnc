[Unit]
Description=CNCFusion LinuxCNC Machine Agent
After=network-online.target
Wants=network-online.target
Requires=cncfusion-hal-helper.service
After=cncfusion-hal-helper.service

[Service]
Type=simple
User=cncfusion
Group=cncfusion
WorkingDirectory=/opt/CNCFusion
EnvironmentFile=/etc/cncfusion/agent.env
ExecStart=/opt/CNCFusion/.venv/bin/python -m agent --bind ${CNCFUSION_AGENT_BIND} --port ${CNCFUSION_AGENT_PORT} --ca-file /etc/cncfusion/ca.crt --certificate-file /etc/cncfusion/server.crt --private-key-file /etc/cncfusion/server.key --config-root /home/darrell/linuxcnc/configs --gcode-root /home/darrell/linuxcnc/nc_files --hal-helper-socket /run/cncfusion/hal-helper.sock --client-fingerprint ${CNCFUSION_CLIENT_FINGERPRINT}
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/cncfusion/updates /home/darrell/linuxcnc/configs /home/darrell/linuxcnc/nc_files

[Install]
WantedBy=multi-user.target
