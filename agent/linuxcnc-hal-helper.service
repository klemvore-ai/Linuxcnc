[Unit]
Description=LinuxCNC HAL helper
After=network.target

[Service]
Type=simple
User=darrell
Group=linuxcnc
WorkingDirectory=/opt/LinuxCNC
RuntimeDirectory=linuxcnc
ExecStart=/opt/LinuxCNC/.venv/bin/python -m agent.hal_helper
Restart=on-failure
RestartSec=2
ProtectSystem=full
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
