# --- CONFIGURATION PARAMETERS ---
setp hm2_7i76e.0.stepgen.timer-number 1
setp hm2_7i76e.0.stepgen.00.steplen 5000
setp hm2_7i76e.0.stepgen.00.stepspace 5000
setp hm2_7i76e.0.stepgen.00.dirsetup 10000
setp hm2_7i76e.0.stepgen.00.dirhold 10000
setp [HM2](BOARD).0.address 10.10.10.10

# --- WIRING CONNECTIONS ---
net sig_0 spindle.0.on => spindle-enable
net sig_1 joint.0.motor-pos-cmd => hm2_7i76e.0.stepgen.00.position-cmd
net sig_2 joint.1.motor-pos-cmd => hm2_7i76e.0.stepgen.01.position-cmd
net sig_3 joint.1.motor-pos-cmd => hm2_7i76e.0.stepgen.03.position-cmd
net sig_4 joint.2.motor-pos-cmd => hm2_7i76e.0.stepgen.02.position-cmd