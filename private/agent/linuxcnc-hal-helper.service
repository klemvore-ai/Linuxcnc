[Unit]
Description=LinuxCNC read-only LinuxCNC HAL helper
After=network.target

[Service]
Type=simple
User=darrell
Group=linuxcnc
WorkingDirectory=/opt/LinuxCNC
ExecStart=/opt/LinuxCNC/.venv/bin/python -m agent.hal_helper --socket /run/linuxcnc/hal-helper.sock
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=full
ProtectHome=true
RuntimeDirectory=linuxcnc
RuntimeDirectoryMode=0750

[Install]
WantedBy=multi-user.target